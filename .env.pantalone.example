# Шаблон секретов профиля "pantalone" — заполнить и сохранить как .env.pantalone
# (файл .env.pantalone в .gitignore, не коммитить; переносить на сервер через scp,
# не через вставку в редактор). Запускать процесс с PROFILE=pantalone — см.
# profiles/pantalone.yaml для несекретных данных профиля (персонаж, сид-данные, тексты).

# Telegram
BOT_TOKEN=
# Telegram user_id владельца — сидится дефолтными категориями/источниками
OWNER_TELEGRAM_ID=
# Доп. пользователь (второй человек), через запятую — свой леджер, без сидинга
ADDITIONAL_TELEGRAM_IDS=

# sqlite — общий файл со всеми профилями (леджеры разделены по user_id)
DB_PATH=./data/willem.db

# Google Sheets — свой service account можно не заводить, обычно хватает
# того же credentials.json, что и у остальных профилей (расшарить новую
# таблицу на его client_email)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Прочее
TIMEZONE=Asia/Almaty
LOG_LEVEL=INFO
